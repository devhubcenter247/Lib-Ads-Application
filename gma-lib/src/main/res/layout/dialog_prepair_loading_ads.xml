<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/loadingDialogBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/bg_loading_ads_card"
        android:gravity="center"
        android:minHeight="168dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/loading_dialog_lottie"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="@dimen/_120sdp"
            android:scaleX="2"
            android:scaleY="2"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/resume_loading" />

        <TextView
            android:id="@+id/loading_dialog_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/loading_ads"
            android:textColor="@color/loadingDialogText"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
